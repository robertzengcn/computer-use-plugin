{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aifetchly.dev/schemas/computer-use/tools/plugin-manifest-v1.json",
  "title": "Common plugin manifest",
  "description": "Hub-consumed plugin identity and compatibility declaration (design §7.1). Declares which local runtime IDs the plugin can use; the host accepts only IDs in its compiled allowlist, so this manifest can never add a runtime or change a download URL.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "contractVersions", "platforms", "localAiRuntimes"],
  "properties": {
    "id": { "const": "aifetchly-computer-use" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[a-z0-9.-]+)?$" },
    "contractVersions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publicTools", "desktop", "grounding", "modelManifest", "trace"],
      "properties": {
        "publicTools": { "type": "integer", "minimum": 1 },
        "desktop": { "type": "integer", "minimum": 1 },
        "grounding": { "type": "integer", "minimum": 1 },
        "modelManifest": { "type": "integer", "minimum": 1 },
        "trace": { "type": "integer", "minimum": 1 }
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["win32-x64", "darwin-arm64"] }
    },
    "localAiRuntimes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["runtimeId", "minVersion"],
        "properties": {
          "runtimeId": {
            "type": "string",
            "enum": ["grounding-onnxruntime", "grounding-model-gui-actor-2b-fp16", "grounding-model-gui-actor-2b-int4"],
            "$comment": "Host-compiled allowlist only; a plugin can never mint new runtime IDs."
          },
          "minVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
        }
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["windows", "macos"],
      "properties": {
        "windows": { "$ref": "#/$defs/backendStatus" },
        "macos": { "$ref": "#/$defs/backendStatus" }
      }
    },
    "skills": {
      "type": "array",
      "items": { "type": "string", "maxLength": 256 }
    }
  },
  "$defs": {
    "backendStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["spike-pending", "candidate", "qualified"],
          "$comment": "Only 'qualified' combinations may be activated by the host; candidates are handoff-only (design §7.5)."
        },
        "artifactDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
