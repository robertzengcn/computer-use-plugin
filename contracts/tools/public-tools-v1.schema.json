{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aifetchly.dev/schemas/computer-use/tools/public-tools-v1.json",
  "title": "Public tool surface",
  "description": "The complete model-visible tool surface (design \u00a73.1, CU-PLUGIN-02). Nine tools exactly; each tool's input and result are strictly shaped. Raw coordinates, model-supplied grants or approvals are structurally rejected in act payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "tools"
  ],
  "properties": {
    "contractVersion": {
      "const": 1
    },
    "tools": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "$ref": "#/$defs/toolEntry"
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "name": {
                "const": "computer_capabilities"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "computer_start_session"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "computer_observe"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "computer_find"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "computer_act"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "computer_verify"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "computer_request_handoff"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "computer_resume_after_handoff"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "computer_stop_session"
              }
            },
            "required": [
              "name"
            ]
          }
        }
      ]
    }
  },
  "$defs": {
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "observationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "targetHandle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "$comment": "Opaque host-minted handle; never coordinates."
    },
    "toolEntry": {
      "oneOf": [
        {
          "$ref": "#/$defs/capabilitiesTool"
        },
        {
          "$ref": "#/$defs/startSessionTool"
        },
        {
          "$ref": "#/$defs/observeTool"
        },
        {
          "$ref": "#/$defs/findTool"
        },
        {
          "$ref": "#/$defs/actTool"
        },
        {
          "$ref": "#/$defs/verifyTool"
        },
        {
          "$ref": "#/$defs/requestHandoffTool"
        },
        {
          "$ref": "#/$defs/resumeTool"
        },
        {
          "$ref": "#/$defs/stopSessionTool"
        }
      ]
    },
    "capabilitiesTool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description"
      ],
      "properties": {
        "name": {
          "const": "computer_capabilities"
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 500
        },
        "input": {
          "$ref": "#/$defs/noInput"
        },
        "result": {
          "$ref": "https://aifetchly.dev/schemas/computer-use/desktop/capabilities-v1.json"
        }
      }
    },
    "startSessionTool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description"
      ],
      "properties": {
        "name": {
          "const": "computer_start_session"
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 500
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "targetRef",
            "purpose"
          ],
          "properties": {
            "targetRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "$comment": "User-selected target reference; the host resolves it, never the model."
            },
            "purpose": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          }
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sessionId",
            "scopedCapabilities"
          ],
          "properties": {
            "sessionId": {
              "$ref": "#/$defs/sessionId"
            },
            "scopedCapabilities": {
              "$ref": "https://aifetchly.dev/schemas/computer-use/desktop/capabilities-v1.json"
            }
          }
        }
      }
    },
    "observeTool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description"
      ],
      "properties": {
        "name": {
          "const": "computer_observe"
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 500
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sessionId"
          ],
          "properties": {
            "sessionId": {
              "$ref": "#/$defs/sessionId"
            },
            "mode": {
              "type": "string",
              "enum": [
                "local_only",
                "visual_planner"
              ]
            }
          }
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observationId",
            "metadata"
          ],
          "properties": {
            "observationId": {
              "$ref": "#/$defs/observationId"
            },
            "metadata": {
              "$ref": "https://aifetchly.dev/schemas/computer-use/desktop/observation-v1.json#/$defs/observationMetadata"
            },
            "state": {
              "$ref": "https://aifetchly.dev/schemas/computer-use/desktop/observation-v1.json#/$defs/observationState",
              "$comment": "E16: structured window/AX state (design §3.1). Optional for backward compatibility; when present it carries the bounded windows/axTree required for host validation. Raw coordinates/approval/grant fields remain rejected for actions."
            }
          }
        }
      }
    },
    "findTool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description"
      ],
      "properties": {
        "name": {
          "const": "computer_find"
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 500
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sessionId",
            "observationId",
            "targetDescription"
          ],
          "properties": {
            "sessionId": {
              "$ref": "#/$defs/sessionId"
            },
            "observationId": {
              "$ref": "#/$defs/observationId"
            },
            "targetDescription": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          }
        },
        "result": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "targetHandle",
                "groundingSource"
              ],
              "properties": {
                "targetHandle": {
                  "$ref": "#/$defs/targetHandle"
                },
                "groundingSource": {
                  "type": "string",
                  "enum": [
                    "accessibility",
                    "vision"
                  ]
                },
                "evidenceSummary": {
                  "type": "string",
                  "maxLength": 300
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "errorCode"
              ],
              "properties": {
                "errorCode": {
                  "type": "string",
                  "enum": [
                    "target_not_found",
                    "target_ambiguous"
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "actTool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description"
      ],
      "properties": {
        "name": {
          "const": "computer_act"
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 500
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sessionId",
            "targetHandle",
            "actionId",
            "action"
          ],
          "properties": {
            "sessionId": {
              "$ref": "#/$defs/sessionId"
            },
            "targetHandle": {
              "$ref": "#/$defs/targetHandle"
            },
            "actionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "action": {
              "$ref": "https://aifetchly.dev/schemas/computer-use/desktop/action-v1.json#/$defs/typedAction"
            }
          },
          "$comment": "additionalProperties:false rejects raw x/y coordinates, grants, approvals and every model-supplied authority field."
        },
        "result": {
          "$ref": "https://aifetchly.dev/schemas/computer-use/desktop/action-v1.json#/$defs/actionOutcome"
        }
      }
    },
    "verifyTool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description"
      ],
      "properties": {
        "name": {
          "const": "computer_verify"
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 500
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sessionId",
            "expectedState"
          ],
          "properties": {
            "sessionId": {
              "$ref": "#/$defs/sessionId"
            },
            "expectedState": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "observationId": {
              "$ref": "#/$defs/observationId"
            }
          }
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verification"
          ],
          "properties": {
            "verification": {
              "type": "string",
              "enum": [
                "satisfied",
                "unsatisfied",
                "unknown"
              ]
            },
            "evidence": {
              "type": "string",
              "maxLength": 300
            }
          }
        }
      }
    },
    "requestHandoffTool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description"
      ],
      "properties": {
        "name": {
          "const": "computer_request_handoff"
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 500
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sessionId",
            "reason"
          ],
          "properties": {
            "sessionId": {
              "$ref": "#/$defs/sessionId"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          }
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sessionId",
            "inputRevoked"
          ],
          "properties": {
            "sessionId": {
              "$ref": "#/$defs/sessionId"
            },
            "inputRevoked": {
              "const": true
            }
          }
        }
      }
    },
    "resumeTool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description"
      ],
      "properties": {
        "name": {
          "const": "computer_resume_after_handoff"
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 500
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sessionId"
          ],
          "properties": {
            "sessionId": {
              "$ref": "#/$defs/sessionId"
            }
          }
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sessionId",
            "observationId"
          ],
          "properties": {
            "sessionId": {
              "$ref": "#/$defs/sessionId"
            },
            "observationId": {
              "$ref": "#/$defs/observationId"
            }
          }
        }
      }
    },
    "stopSessionTool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description"
      ],
      "properties": {
        "name": {
          "const": "computer_stop_session"
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 500
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sessionId"
          ],
          "properties": {
            "sessionId": {
              "$ref": "#/$defs/sessionId"
            }
          }
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sessionId",
            "stopped"
          ],
          "properties": {
            "sessionId": {
              "$ref": "#/$defs/sessionId"
            },
            "stopped": {
              "const": true
            }
          }
        }
      }
    },
    "noInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {},
      "$comment": "computer_capabilities takes no input."
    }
  }
}