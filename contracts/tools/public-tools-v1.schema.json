{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aifetchly.dev/schemas/computer-use/tools/public-tools-v1.json",
  "title": "Public tool surface",
  "description": "The complete model-visible tool surface for computer use (design §3.1). Exactly these nine tools; no raw backend tool is advertised as a planner tool (CU-PLUGIN-02).",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "tools"],
  "properties": {
    "contractVersion": { "const": 1 },
    "tools": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": { "$ref": "#/$defs/toolEntry" },
      "$comment": "Exactly the reviewed v1 surface; adding a tool requires a new contract version."
    }
  },
  "$defs": {
    "toolName": {
      "type": "string",
      "enum": [
        "computer_capabilities",
        "computer_start_session",
        "computer_observe",
        "computer_find",
        "computer_act",
        "computer_verify",
        "computer_request_handoff",
        "computer_resume_after_handoff",
        "computer_stop_session"
      ]
    },
    "toolEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": { "$ref": "#/$defs/toolName" },
        "description": { "type": "string", "minLength": 10, "maxLength": 500 },
        "input": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/toolName" },
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        },
        "result": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  },
  "allOf": [
    { "contains": { "properties": { "tools": { "contains": { "properties": { "name": { "const": "computer_capabilities" } } } } } } },
    { "contains": { "properties": { "tools": { "contains": { "properties": { "name": { "const": "computer_start_session" } } } } } } },
    { "contains": { "properties": { "tools": { "contains": { "properties": { "name": { "const": "computer_observe" } } } } } } },
    { "contains": { "properties": { "tools": { "contains": { "properties": { "name": { "const": "computer_find" } } } } } } },
    { "contains": { "properties": { "tools": { "contains": { "properties": { "name": { "const": "computer_act" } } } } } } },
    { "contains": { "properties": { "tools": { "contains": { "properties": { "name": { "const": "computer_verify" } } } } } } },
    { "contains": { "properties": { "tools": { "contains": { "properties": { "name": { "const": "computer_request_handoff" } } } } } } },
    { "contains": { "properties": { "tools": { "contains": { "properties": { "name": { "const": "computer_resume_after_handoff" } } } } } } },
    { "contains": { "properties": { "tools": { "contains": { "properties": { "name": { "const": "computer_stop_session" } } } } } } }
  ]
}
