{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aifetchly.dev/schemas/computer-use/evidence/report-core-v1.json",
  "$comment": "Shared report envelope: every evidence suite carries run, configuration, cases, aggregate and qualification blocks. Suite schemas refine this core.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "run", "configuration", "cases", "aggregate", "qualification"],
  "properties": {
    "schema": { "type": "string", "minLength": 1 },
    "run": {
      "type": "object",
      "additionalProperties": true,
      "required": ["mode", "datasetId", "datasetVersion", "runnerKind", "sourceCommit", "provider"],
      "properties": {
        "mode": { "type": "string", "minLength": 1 },
        "datasetId": { "type": "string", "minLength": 1 },
        "datasetVersion": { "type": "string", "minLength": 1 },
        "runnerKind": { "type": "string", "minLength": 1 },
        "sourceCommit": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "timestamp": { "type": "string", "minLength": 1 },
        "hardware": { "type": "string", "minLength": 1 },
        "consumerBuild": { "type": "string", "minLength": 1 },
        "artifactDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": true,
      "required": ["modelConfigurationId", "adapterId"],
      "properties": {
        "modelConfigurationId": { "type": "string", "minLength": 1 },
        "adapterId": { "type": "string", "minLength": 1 }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["caseId", "fixtureHash", "status"],
        "properties": {
          "caseId": { "type": "string", "minLength": 1 },
          "fixtureHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "status": { "type": "string", "enum": ["pass", "passed", "fail", "failed", "skipped"] }
        }
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": true,
      "required": ["planned", "executed", "passed", "failed", "skipped"],
      "properties": {
        "planned": { "type": "integer", "minimum": 0 },
        "executed": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": true,
      "required": ["missingEvidence"],
      "properties": {
        "missingEvidence": { "type": "array", "items": { "type": "string" } },
        "producerOnly": { "type": "boolean" }
      }
    }
  }
}
