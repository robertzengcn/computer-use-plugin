{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aifetchly.dev/schemas/computer-use/launch/windows-profile-v1.json",
  "title": "Windows managed-backend launch profile",
  "description": "Exact reviewed Windows launch contract: managed Python entrypoint, unbuffered stdio, managed cwd, disabled telemetry (design §1.3, §4.2).",
  "type": "object",
  "additionalProperties": true,
  "required": ["version", "transport", "cwd", "envPolicy", "stdoutPolicy", "upstreamLockRequired"],
  "properties": {
    "version": { "const": 1 },
    "transport": { "const": "stdio-jsonrpc" },
    "argv": {
      "type": "array",
      "prefixItems": [
        { "const": "<managed-python>" },
        { "const": "-u" },
        { "const": "-m" },
        { "const": "aifetchly_windows.entrypoint" }
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "argvTemplate": {
      "type": "array",
      "prefixItems": [
        { "const": "<managed-python>" },
        { "const": "-u" },
        { "const": "-m" },
        { "const": "aifetchly_windows.entrypoint" }
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "cwd": { "const": "<managed-env-root>" },
    "envPolicy": {
      "type": "object",
      "required": ["telemetry", "noGlobalPath", "extra"],
      "properties": {
        "telemetry": { "const": "disabled" },
        "noGlobalPath": { "const": true },
        "extra": {
          "type": "object",
          "required": ["PYTHONUNBUFFERED"],
          "properties": {
            "PYTHONUNBUFFERED": { "const": "1" }
          }
        }
      }
    },
    "stdoutPolicy": { "const": "protocol-only" },
    "upstreamLockRequired": { "const": "pinned" }
  },
  "anyOf": [
    { "required": ["argv"] },
    { "required": ["argvTemplate"] }
  ]
}
