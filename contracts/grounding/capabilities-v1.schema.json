{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aifetchly.dev/schemas/computer-use/grounding/capabilities-v1.json",
  "title": "Grounding adapter capabilities",
  "description": "What a grounding adapter accepts and produces, declared before load (design §3.4.1).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "adapterId",
    "adapterVersion",
    "acceptedArchitectures",
    "acceptedManifestVersions",
    "onnxRuntime",
    "image",
    "output",
    "cooperativeCancel"
  ],
  "properties": {
    "contractVersion": { "const": 1 },
    "adapterId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "adapterVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
    "acceptedArchitectures": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "maxLength": 128 }
    },
    "acceptedManifestVersions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1 }
    },
    "onnxRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "providers"],
      "properties": {
        "version": { "type": "string", "minLength": 1, "maxLength": 32 },
        "providers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["dml", "coreml", "cpu"] }
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "maxPixels", "maxBytes", "cropSupported"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["png", "jpeg"] }
        },
        "maxPixels": { "type": "integer", "minimum": 1, "maximum": 67108864 },
        "maxBytes": { "type": "integer", "minimum": 1 },
        "cropSupported": { "type": "boolean" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["point", "region", "heatmap", "absencePolicy"],
      "properties": {
        "point": { "type": "boolean" },
        "region": { "type": "boolean" },
        "heatmap": { "type": "boolean", "$comment": "Point-only output without a heatmap is valid (CU-PLUGIN-03)." },
        "absencePolicy": {
          "type": "string",
          "enum": ["none", "calibrated_threshold", "ax_cross_check"],
          "$comment": "Adapters without a qualified absence policy cannot be selected for autonomous input (design §3.4.2)."
        }
      }
    },
    "cooperativeCancel": { "type": "boolean" }
  }
}
